{
  "name": "student-tech-recommender",
  "version": "1.0.0",
  "description": "AI-powered recommendation agent for students to infer tech interests and recommend reels",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run start --prefix backend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix backend",
    "test:eval": "npm run test:eval --prefix backend",
    "test:trap": "npm run test:trap --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "ai-agent",
    "recommendation-engine",
    "student-reels",
    "semantic-analysis",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
